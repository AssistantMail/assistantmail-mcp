{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.AssistantMail/assistantmail-mcp",
  "title": "Assistant Mail MCP",
  "description": "Agent email with allowlist and consent via AssistantMail.",
  "websiteUrl": "https://assistant-mail.ai/docs",
  "repository": {
    "url": "https://github.com/AssistantMail/assistantmail-mcp",
    "source": "github"
  },
  "version": "1.3.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@assistantmail/assistantmail-mcp",
      "version": "1.3.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "ASSISTANT_MAIL_API_KEY",
          "description": "AssistantMail API key (amk_...). Required unless passed per-tool.",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        },
        {
          "name": "ASSISTANT_MAIL_API_BASE_URL",
          "description": "Optional AssistantMail API base URL.",
          "isRequired": false,
          "isSecret": false,
          "format": "string",
          "default": "https://api.assistant-mail.ai"
        }
      ]
    }
  ]
}
